#!/usr/bin/env bash
#
# VMANGOS Manager - Main CLI Entry Point
#

set -euo pipefail

# ============================================================================
# GLOBALS
# ============================================================================

# `${BASH_SOURCE[0]}` is the path this script was **invoked as**, not the path it lives
# at. The documented install puts a symlink in front of it
# (`ln -s $PREFIX/bin/vmangos-manager /usr/local/bin/vmangos-manager`), so on an installed
# host that value is the symlink and `LIB_DIR="$SCRIPT_DIR/../lib"` resolves beside
# `/usr/local/bin` instead of beside the prefix. Measured on bds at v0.7.24 (2026-10-31):
# every subcommand run through that symlink died at the first `source` — exit 1, no
# stdout, `line 171: /usr/local/bin/../lib/common.sh: No such file or directory` — while
# `command -v vmangos-manager` still resolved, so the install check passed. Following the
# link is the whole fix; the fallback keeps it working where readlink has no `-f`.
SELF_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
readonly SELF_PATH
SCRIPT_DIR="$(cd "$(dirname "$SELF_PATH")" && pwd)"
readonly SCRIPT_DIR

readonly LIB_DIR="$SCRIPT_DIR/../lib"
MANAGER_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly MANAGER_ROOT

# Version handling
#
# `manager/VERSION` is the single source of truth and is installed beside the
# CLI, so a running host can always name its own release. The embedded fallback
# exists only for running an unpackaged tree; a unit test asserts it agrees with
# the VERSION file, which is what stops the fallback silently rotting between
# releases (the reason a 0.5.x host reported "version 0.3.1" when you asked it).
readonly VERSION_FALLBACK="0.7.34"

manager_read_version() {
    local version_file="$MANAGER_ROOT/VERSION"
    local version=""

    if [[ -f "$version_file" ]]; then
        version=$(tr -d '[:space:]' <"$version_file" 2>/dev/null || echo "")
    fi

    if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        version="$VERSION_FALLBACK"
    fi

    printf '%s' "$version"
}

VERSION="$(manager_read_version)"
readonly VERSION

# Written by `make install`: one line identifying the exact build on this host,
# so an operator can prove what is deployed instead of trusting a checkout.
manager_build_info() {
    local info_file="$MANAGER_ROOT/build-info"
    if [[ -f "$info_file" ]]; then
        tr -d '\n' <"$info_file" 2>/dev/null || true
    fi
}

# Global options (exported for use by sourced libraries)
VERBOSE=0
OUTPUT_FORMAT="text"

# ============================================================================
# USAGE
# ============================================================================

show_help() {
    cat << EOF
VMANGOS Manager - Server Management Tool
Version: $VERSION

USAGE:
    vmangos-manager [GLOBAL_OPTIONS] [<COMMAND> [SUBCOMMAND_OPTIONS]]

    Running with no COMMAND starts the dashboard (5s refresh, auto-detected
    config) — the everyday way to launch it.

GLOBAL OPTIONS:
    -c, --config FILE      Configuration file path
    -v, --verbose          Enable verbose output
    -f, --format FORMAT    Output format: text | json
    -h, --help             Show this help message
    --version              Show version information

COMMANDS:
    server [start|stop|restart|status] [OPTIONS]
      start options: [--wait] [--timeout SECONDS]
      stop options: [--graceful|--force] [--timeout SECONDS]
      restart options: [--timeout SECONDS]
      status options: [--format text|json] [--watch] [--interval SECONDS]
    dashboard [--refresh SECONDS] [--theme dark|light] [--bootstrap]   (default refresh: 5s)
    install [--bootstrap]   (root; one-time install wizard — forms, review, launch)
    logs [status|rotate|test-config|recent] [OPTIONS]
      recent options: [--source all|auth|world] [--window 15m|1h|1d] [--severity all|debug|info|notice|warning|error|critical|alert] [--limit N] [--watch|--follow] [--interval SECONDS] [--format text|json]
    account [create|list|setgm|ban|unban|password] [OPTIONS]
    update [check|inspect|plan|apply] [OPTIONS]
    schedule [honor|restart|list|cancel|simulate] [OPTIONS]
    config [create|validate|show|detect|grant] [OPTIONS]
      grant options: --user NAME [--group NAME] [--format text|json]  (run as root; grants NAME
                      read access to the config and write access to backups via a shared group)
    backup [now|list|verify|restore|clean|schedule] [OPTIONS]
      restore options: <file> [--dry-run | --preflight] [--yes] [--backup-first] [--format text|json]
                        dry-run: print the restore plan, no checks with side effects
                        preflight: run all restore readiness checks (verify, credentials, auth probe)
      schedule options: [status] [--daily HH:MM | --weekly "Sun 04:00"] [--format text|json]
EOF
}

show_version() {
    local build_info
    echo "VMANGOS Manager version $VERSION"
    build_info=$(manager_build_info)
    if [[ -n "$build_info" ]]; then
        echo "  build: $build_info"
    fi
}

# ============================================================================
# ARGUMENT PARSING
# ============================================================================

parse_global_options() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -v|--verbose)
                VERBOSE=1
                shift
                ;;
            -f|--format)
                if [[ -n "${2:-}" ]]; then
                    OUTPUT_FORMAT="$2"
                    shift 2
                else
                    echo "Error: --format requires an argument" >&2
                    exit 2
                fi
                ;;
            -c|--config)
                if [[ -n "${2:-}" ]]; then
                    CONFIG_FILE="$2"
                    shift 2
                else
                    echo "Error: --config requires an argument" >&2
                    exit 2
                fi
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            --version)
                show_version
                exit 0
                ;;
            --)
                shift
                break
                ;;
            -*)
                echo "Error: Unknown option: $1" >&2
                exit 2
                ;;
            *)
                break
                ;;
        esac
    done
}

# ============================================================================
# COMMAND HANDLERS
# ============================================================================

